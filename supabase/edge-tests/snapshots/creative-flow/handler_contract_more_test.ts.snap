 },
 "tools": [
  {
   "name": "proposer_hooks",
   "description": "Retourne 3 hooks d'ouverture de reel, de types différents.",
   "input_schema": {
    "type": "object",
    "properties": {
     "hooks": {
      "type": "array",
      "description": "TABLEAU de 3 objets hook — jamais une chaîne de caractères, jamais du JSON stringifié",
      "items": {
