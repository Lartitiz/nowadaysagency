      "type": "string"
     },
     "objectif": {
      "type": "string"
     },
     "personal_tip": {
      "type": [
       "string",
       "null"
      ],
      "description": "Conseil d'incarnation SEULEMENT si demandé plus haut, sinon null."
     }
    },
    "required": [
     "content",
     "accroche"
    ]
   }
  }
 ],
 "temperature": 0.85,
 "max_tokens": 4096,
 "tool_choice": {
  "type": "tool",
  "name": "rediger_post"
 },
 "stream": true
}\`
`;

