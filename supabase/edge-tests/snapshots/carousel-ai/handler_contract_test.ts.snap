[]\\\\\\"}],\\\\\\"sequence\\\\\\":{\\\\\\"slides\\\\\\":[{\\\\\\"id\\\\\\":\\\\\\"slides.0\\\\\\",\\\\\\"type\\\\\\":\\\\\\"photo_full\\\\\\",\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.1\\\\\\",\\\\\\"type\\\\\\":\\\\\\"photo_integrated\\\\\\",\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.2\\\\\\",\\\\\\"type\\\\\\":\\\\\\"photo_full\\\\\\",\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.3\\\\\\",\\\\\\"type\\\\\\":\\\\\\"text_only\\\\\\",\\\\\\"no_text\\\\\\":false}],\\\\\\"fields\\\\\\":[{\\\\\\"id\\\\\\":\\\\\\"slides.0.overlay_text\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Ce que tu paies vraiment dans un bol\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.1.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Chaque bol passe trois fois entre mes mains : tournage, tournassage, émaillage.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.2.overlay_text\\\\\\",\\\\\\"text\\\\\\":\\\\\\"En notant mes heures pendant un mois, j'ai vu que 40 % de mon temps partait dans des pièces vendues à perte.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.3.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Mes prix sont publics depuis. Enregistre ce post pour y repenser.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"caption.hook\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Un bol, trois passages.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"caption.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Voilà pourquoi je n'ai plus de remises.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"caption.cta\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Tu affiches tes prix ?\\\\\\"}]}}\\"
