:\\\\\\"[]\\\\\\"}],\\\\\\"sequence\\\\\\":{\\\\\\"slides\\\\\\":[{\\\\\\"id\\\\\\":\\\\\\"slides.0\\\\\\",\\\\\\"type\\\\\\":\\\\\\"photo_full\\\\\\",\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.1\\\\\\",\\\\\\"type\\\\\\":\\\\\\"photo_full\\\\\\",\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.2\\\\\\",\\\\\\"type\\\\\\":\\\\\\"photo_full\\\\\\",\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.3\\\\\\",\\\\\\"type\\\\\\":\\\\\\"photo_full\\\\\\",\\\\\\"no_text\\\\\\":false}],\\\\\\"fields\\\\\\":[{\\\\\\"id\\\\\\":\\\\\\"slides.0.overlay_text\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Ce que tu paies dans un bol\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.1.overlay_text\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Trois passages entre mes mains : tournage, tournassage, émaillage.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.1.kicker\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Le geste\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.2.overlay_text\\\\\\",\\\\\\"text\\\\\\":\\\\\\"40 % de mon temps partait dans des pièces vendues à perte.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.2.big_number\\\\\\",\\\\\\"text\\\\\\":\\\\\\"40 %\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.3.overlay_text\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Mes prix sont publics. Enregistre ce post.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.3.cta_label\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Enregistre ce post\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"caption.hook\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Un bol, trois passages.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"caption.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Voilà pourquoi je n'ai plus de remises.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"caption.cta\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Tu affiches tes prix ?\\\\\\"}]}}\\"
