 \\"model\\": \\"claude-sonnet-4-6\\",
 \\"messages\\": [
  {
   \\"role\\": \\"user\\",
   \\"content\\": \\"{\\\\\\"expected_slide_ids_in_order\\\\\\":[\\\\\\"slides.0\\\\\\",\\\\\\"slides.1\\\\\\",\\\\\\"slides.2\\\\\\",\\\\\\"slides.3\\\\\\",\\\\\\"slides.4\\\\\\"],\\\\\\"expected_boundaries_in_order\\\\\\":[{\\\\\\"from\\\\\\":\\\\\\"slides.0\\\\\\",\\\\\\"to\\\\\\":\\\\\\"slides.1\\\\\\"},{\\\\\\"from\\\\\\":\\\\\\"slides.1\\\\\\",\\\\\\"to\\\\\\":\\\\\\"slides.2\\\\\\"},{\\\\\\"from\\\\\\":\\\\\\"slides.2\\\\\\",\\\\\\"to\\\\\\":\\\\\\"slides.3\\\\\\"},{\\\\\\"from\\\\\\":\\\\\\"slides.3\\\\\\",\\\\\\"to\\\\\\":\\\\\\"slides.4\\\\\\"}],\\\\\\"expected_boundary_ids_in_order\\\\\\":[\\\\\\"slides.0->slides.1\\\\\\",\\\\\\"slides.1->slides.2\\\\\\",\\\\\\"slides.2->slides.3\\\\\\",\\\\\\"slides.3->slides.4\\\\\\"],\\\\\\"allowed_source_ids\\\\\\":[\\\\\\"request\\\\\\",\\\\\\"brand\\\\\\",\\\\\\"photo_context\\\\\\",\\\\\\"photo_observations\\\\\\"],\\\\\\"sources\\\\\\":[{\\\\\\"id\\\\\\":\\\\\\"request\\\\\\",\\\\\\"provenance\\\\\\":\\\\\\"user\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Les trois gestes qui changent un premier bol\\\\\\\\n1. Le tour ; 2. Les mains ; 3. Le four\\\\\\\\nconfiance\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"brand\\\\\\",\\\\\\"provenance\\\\\\":\\\\\\"brand_context\\\\\\",\\\\\\"text\\\\\\":\\\\\\"NOTE : Le profil est très peu rempli. Les résultats seront plus pertinents une fois le Branding et les Offres complétés.\\\\\\\\n\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"photo_context\\\\\\",\\\\\\"provenance\\\\\\":\\\\\\"user_context_and_separate_library_inferences\\\\\\",\\\\\\"text\\\\\\":\\\\\\"\\\\\\\\nCONTEXTE PAR PHOTO :\\\\\\\\nPhoto 1 — contexte fourni par la personne : Le tour au matin\\\\\\\\nPhoto 2 — contexte fourni par la personne : Les mains dans la terre\\\\\\\\nPhoto 3 — contexte fourni par la personne : Le four ouvert\\\\\\\\nLes indications de bibliothèque aident à reconnaître l'image ; elles ne prouvent ni origine, fabrication, identité, chronologie, résultat ni vécu. Le contexte explicite de la personne prime.\\\\\\\\n\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"photo_observations\\\\\\",\\\\\\"provenance\\\\\\":\\\\\\"visual_observation_inferred_by_planner_not_verified_identity_or_history\\\\\\",\\\\\\"text\\\\\\":\\\\\\"[]\\\\\\"}],\\\\\\"sequence\\\\\\":{\\\\\\"slides\\\\\\":[{\\\\\\"id\\\\\\":\\\\\\"slides.0\\\\\\",\\\\\\"type\\\\\\":\\\\\\"photo_full\\\\\\",\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.1\\\\\\",\\\\\\"type\\\\\\":\\\\\\"photo_integrated\\\\\\",\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.2\\\\\\",\\\\\\"type\\\\\\":\\\\\\"text_only\\\\\\",\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.3\\\\\\",\\\\\\"type\\\\\\":\\\\\\"photo_integrated\\\\\\",\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.4\\\\\\",\\\\\\"type\\\\\\":\\\\\\"text_only\\\\\\",\\\\\\"no_text\\\\\\":false}],\\\\\\"fields\\\\\\":[{\\\\\\"id\\\\\\":\\\\\\"slides.0.overlay_text\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Trois gestes pour ton premier bol\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.1.title\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Centrer la terre\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.1.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Les coudes calés sur les cuisses, tu pousses la terre vers le centre jusqu'à ce qu'elle ne bouge plus.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.2.title\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Ouvrir sans percer\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.2.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Le pouce descend jusqu'à un centimètre du fond, pas plus : 1 cm suffit pour un fond solide.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.3.title\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Monter la paroi\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.3.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Une main dedans, une main dehors, tu remontes lentement en trois passes.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.4.title\\\\\\",\\\\\\"text\\\\\\":\\\\\\"À toi\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.4.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Lequel de ces gestes te pose le plus de mal ? Enregistre ce post pour ta prochaine séance.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"caption.hook\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Trois gestes.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"caption.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Le premier bol tient à ça.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"caption.cta\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Dis-moi lequel te résiste.\\\\\\"}]}}\\"
  }
