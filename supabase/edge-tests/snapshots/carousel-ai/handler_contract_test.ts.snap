      ],
      \\"description\\": \\"Ce que demande la consigne : le texte, la mise en page seule, les deux, ou un schéma.\\"
     },
     \\"slide\\": {
      \\"type\\": \\"object\\",
      \\"description\\": \\"Les champs de texte de la slide refaite (ceux de son type).\\",
      \\"properties\\": {
