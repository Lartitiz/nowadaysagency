 \\"model\\": \\"claude-sonnet-4-6\\",
 \\"messages\\": [
  {
   \\"role\\": \\"user\\",
   \\"content\\": \\"{\\\\\\"expected_slide_ids_in_order\\\\\\":[\\\\\\"slides.0\\\\\\",\\\\\\"slides.1\\\\\\",\\\\\\"slides.2\\\\\\",\\\\\\"slides.3\\\\\\",\\\\\\"slides.4\\\\\\"],\\\\\\"expected_boundaries_in_order\\\\\\":[{\\\\\\"from\\\\\\":\\\\\\"slides.0\\\\\\",\\\\\\"to\\\\\\":\\\\\\"slides.1\\\\\\"},{\\\\\\"from\\\\\\":\\\\\\"slides.1\\\\\\",\\\\\\"to\\\\\\":\\\\\\"slides.2\\\\\\"},{\\\\\\"from\\\\\\":\\\\\\"slides.2\\\\\\",\\\\\\"to\\\\\\":\\\\\\"slides.3\\\\\\"},{\\\\\\"from\\\\\\":\\\\\\"slides.3\\\\\\",\\\\\\"to\\\\\\":\\\\\\"slides.4\\\\\\"}],\\\\\\"expected_boundary_ids_in_order\\\\\\":[\\\\\\"slides.0->slides.1\\\\\\",\\\\\\"slides.1->slides.2\\\\\\",\\\\\\"slides.2->slides.3\\\\\\",\\\\\\"slides.3->slides.4\\\\\\"],\\\\\\"allowed_source_ids\\\\\\":[\\\\\\"request\\\\\\",\\\\\\"brand\\\\\\",\\\\\\"photo_observations\\\\\\",\\\\\\"news\\\\\\"],\\\\\\"sources\\\\\\":[{\\\\\\"id\\\\\\":\\\\\\"request\\\\\\",\\\\\\"provenance\\\\\\":\\\\\\"user\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Pourquoi je ne fais plus de remises sur mes créations\\\\\\\\n{\\\\\\\\\\\\\\"La dernière fois qu'on t'a demandé une remise ?\\\\\\\\\\\\\\":\\\\\\\\\\\\\\"J'ai dit non, et la cliente a signé quand même.\\\\\\\\\\\\\\"}\\\\\\\\n{\\\\\\\\\\\\\\"La dernière fois qu'on t'a demandé une remise ?\\\\\\\\\\\\\\":\\\\\\\\\\\\\\"J'ai dit non, et la cliente a signé quand même.\\\\\\\\\\\\\\"}\\\\\\\\nconfiance\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"brand\\\\\\",\\\\\\"provenance\\\\\\":\\\\\\"brand_context\\\\\\",\\\\\\"text\\\\\\":\\\\\\"NOTE : Le profil est très peu rempli. Les résultats seront plus pertinents une fois le Branding et les Offres complétés.\\\\\\\\n\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"photo_observations\\\\\\",\\\\\\"provenance\\\\\\":\\\\\\"visual_observation_inferred_by_planner_not_verified_identity_or_history\\\\\\",\\\\\\"text\\\\\\":\\\\\\"[]\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"news\\\\\\",\\\\\\"provenance\\\\\\":\\\\\\"provided_reference\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Une étude publiée cette semaine montre que les artisan·es baissent leurs prix en fin d'année.\\\\\\"}],\\\\\\"sequence\\\\\\":{\\\\\\"slides\\\\\\":[{\\\\\\"id\\\\\\":\\\\\\"slides.0\\\\\\",\\\\\\"type\\\\\\":null,\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.1\\\\\\",\\\\\\"type\\\\\\":null,\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.2\\\\\\",\\\\\\"type\\\\\\":null,\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.3\\\\\\",\\\\\\"type\\\\\\":null,\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.4\\\\\\",\\\\\\"type\\\\\\":null,\\\\\\"no_text\\\\\\":false}],\\\\\\"fields\\\\\\":[{\\\\\\"id\\\\\\":\\\\\\"slides.0.title\\\\\\",\\\\\\"text\\\\\\":\\\\\\"J'ai arrêté les remises\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.0.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Il y a un an, une cliente m'a demandé dix pour cent de moins sur un service de bols.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.1.title\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Ce que coûte un bol\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.1.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Chaque bol passe trois fois entre mes mains : tournage, tournassage, émaillage.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.2.title\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Le temps compté\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.2.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"En notant mes heures pendant un mois, j'ai vu que 40 % de mon temps partait dans des pièces vendues à perte.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.3.title\\\\\\",\\\\\\"text\\\\\\":\\\\\\"La réponse\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.3.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"J'ai expliqué ce temps à la cliente, simplement. Elle a signé quand même.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.4.title\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Et toi ?\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.4.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Tu affiches tes prix ou tu les négocies ? Enregistre ce post pour y repenser.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"caption.hook\\\\\\",\\\\\\"text\\\\\\":\\\\\\"J'ai arrêté les remises.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"caption.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Et la cliente a signé quand même.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"caption.cta\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Dis-moi en commentaire comment tu fixes tes prix.\\\\\\"}]}}\\"
