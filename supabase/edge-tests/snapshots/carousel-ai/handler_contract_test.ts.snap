 \\"tools\\": [
  {
   \\"name\\": \\"juger_progression\\",
   \\"description\\": \\"Contrôle global de la version finale des slides. Le statut technique est géré par le code.\\",
   \\"input_schema\\": {
    \\"type\\": \\"object\\",
    \\"additionalProperties\\": false,
    \\"required\\": [
     \\"idea_read\\",
     \\"trajectory\\",
     \\"verdict\\",
     \\"slides\\",
     \\"boundaries\\",
     \\"defects\\",
     \\"conclusion\\",
     \\"limits\\"
    ],
    \\"properties\\": {
     \\"idea_read\\": {
      \\"type\\": \\"string\\",
      \\"minLength\\": 1,
      \\"description\\": \\"Une phrase non vide : idée réellement lue dans le texte.\\"
     },
     \\"trajectory\\": {
      \\"type\\": \\"object\\",
      \\"additionalProperties\\": false,
      \\"required\\": [
       \\"kind\\",
       \\"starting_point\\",
       \\"landing\\",
       \\"reason\\",
       \\"field_ids\\",
       \\"request_source_ids\\"
      ],
      \\"properties\\": {
       \\"kind\\": {
        \\"type\\": \\"string\\",
        \\"enum\\": [
         \\"developed_idea\\",
         \\"requested_series\\",
         \\"descriptive_catalogue\\"
        ]
       },
       \\"starting_point\\": {
        \\"type\\": \\"string\\",
