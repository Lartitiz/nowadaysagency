        },
        \\"edits\\": {
         \\"type\\": \\"array\\",
         \\"items\\": {
          \\"type\\": \\"object\\",
          \\"required\\": [
           \\"before\\",
           \\"after\\"
          ],
          \\"additionalProperties\\": false,
          \\"properties\\": {
