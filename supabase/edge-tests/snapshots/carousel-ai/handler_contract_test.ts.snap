   \\"role\\": \\"user\\",
   \\"content\\": [
    {
     \\"type\\": \\"text\\",
     \\"text\\": \\"{\\\\\\"slides\\\\\\":[{\\\\\\"slide_number\\\\\\":1,\\\\\\"role\\\\\\":\\\\\\"hook\\\\\\",\\\\\\"eligible\\\\\\":false,\\\\\\"title\\\\\\":\\\\\\"J'ai arrêté les remises\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Il y a un an, une cliente m'a demandé dix pour cent de moins sur un service de bols.\\\\\\"},{\\\\\\"slide_number\\\\\\":2,\\\\\\"role\\\\\\":\\\\\\"context\\\\\\",\\\\\\"eligible\\\\\\":true,\\\\\\"title\\\\\\":\\\\\\"Ce que coûte un bol\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Chaque bol passe trois fois entre mes mains : tournage, tournassage, émaillage.\\\\\\"},{\\\\\\"slide_number\\\\\\":3,\\\\\\"role\\\\\\":\\\\\\"proof\\\\\\",\\\\\\"eligible\\\\\\":true,\\\\\\"title\\\\\\":\\\\\\"Le temps compté\\\\\\",\\\\\\"text\\\\\\":\\\\\\"En notant mes heures pendant un mois, j'ai vu que 40 % de mon temps partait dans des pièces vendues à perte.\\\\\\"},{\\\\\\"slide_number\\\\\\":4,\\\\\\"role\\\\\\":\\\\\\"turn\\\\\\",\\\\\\"eligible\\\\\\":true,\\\\\\"title\\\\\\":\\\\\\"La réponse\\\\\\",\\\\\\"text\\\\\\":\\\\\\"J'ai expliqué ce temps à la cliente, simplement. Elle a signé quand même.\\\\\\"},{\\\\\\"slide_number\\\\\\":5,\\\\\\"role\\\\\\":\\\\\\"cta\\\\\\",\\\\\\"eligible\\\\\\":true,\\\\\\"title\\\\\\":\\\\\\"Et toi ?\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Tu affiches tes prix ou tu les négocies ? Enregistre ce post pour y repenser.\\\\\\"}]}\\"
    }
   ]
  }
 ],
