   \\"content\\": \\"{\\\\\\"expected_slide_ids_in_order\\\\\\":[\\\\\\"slides.0\\\\\\",\\\\\\"slides.1\\\\\\",\\\\\\"slides.2\\\\\\",\\\\\\"slides.3\\\\\\"],\\\\\\"expected_boundaries_in_order\\\\\\":[{\\\\\\"from\\\\\\":\\\\\\"slides.0\\\\\\",\\\\\\"to\\\\\\":\\\\\\"slides.1\\\\\\"},{\\\\\\"from\\\\\\":\\\\\\"slides.1\\\\\\",\\\\\\"to\\\\\\":\\\\\\"slides.2\\\\\\"},{\\\\\\"from\\\\\\":\\\\\\"slides.2\\\\\\",\\\\\\"to\\\\\\":\\\\\\"slides.3\\\\\\"}],\\\\\\"expected_boundary_ids_in_order\\\\\\":[\\\\\\"slides.0->slides.1\\\\\\",\\\\\\"slides.1->slides.2\\\\\\",\\\\\\"slides.2->slides.3\\\\\\"],\\\\\\"allowed_source_ids\\\\\\":[\\\\\\"request\\\\\\",\\\\\\"brand\\\\\\",\\\\\\"photo_context\\\\\\",\\\\\\"photo_observations\\\\\\"],\\\\\\"sources\\\\\\":[{\\\\\\"id\\\\\\":\\\\\\"request\\\\\\",\\\\\\"provenance\\\\\\":\\\\\\"user\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Les trois gestes qui changent un premier bol\\\\\\\\nconfiance\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"brand\\\\\\",\\\\\\"provenance\\\\\\":\\\\\\"brand_context\\\\\\",\\\\\\"text\\\\\\":\\\\\\"NOTE : Le profil est très peu rempli. Les résultats seront plus pertinents une fois le Branding et les Offres complétés.\\\\\\\\n\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"photo_context\\\\\\",\\\\\\"provenance\\\\\\":\\\\\\"user_context_and_separate_library_inferences\\\\\\",\\\\\\"text\\\\\\":\\\\\\"\\\\\\\\nCONTEXTE PAR PHOTO :\\\\\\\\nPhoto 1 — contexte fourni par la personne : Le tour au matin\\\\\\\\nPhoto 2 — contexte fourni par la personne : Les mains dans la terre\\\\\\\\nPhoto 3 — contexte fourni par la personne : Le four ouvert\\\\\\\\nLes indications de bibliothèque aident à reconnaître l'image ; elles ne prouvent ni origine, fabrication, identité, chronologie, résultat ni vécu. Le contexte explicite de la personne prime.\\\\\\\\n\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"photo_observations\\\\\\",\\\\\\"provenance\\\\\\":\\\\\\"visual_observation_inferred_by_planner_not_verified_identity_or_history\\\\\\",\\\\\\"text\\\\\\":\\\\\\"[]\\\\\\"}],\\\\\\"sequence\\\\\\":{\\\\\\"slides\\\\\\":[{\\\\\\"id\\\\\\":\\\\\\"slides.0\\\\\\",\\\\\\"type\\\\\\":\\\\\\"photo_full\\\\\\",\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.1\\\\\\",\\\\\\"type\\\\\\":\\\\\\"photo_integrated\\\\\\",\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.2\\\\\\",\\\\\\"type\\\\\\":\\\\\\"photo_full\\\\\\",\\\\\\"no_text\\\\\\":false},{\\\\\\"id\\\\\\":\\\\\\"slides.3\\\\\\",\\\\\\"type\\\\\\":\\\\\\"text_only\\\\\\",\\\\\\"no_text\\\\\\":false}],\\\\\\"fields\\\\\\":[{\\\\\\"id\\\\\\":\\\\\\"slides.0.overlay_text\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Ce que tu paies vraiment dans un bol\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.1.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Chaque bol passe trois fois entre mes mains : tournage, tournassage, émaillage.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.2.overlay_text\\\\\\",\\\\\\"text\\\\\\":\\\\\\"En notant mes heures pendant un mois, j'ai vu que 40 % de mon temps partait dans des pièces vendues à perte.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"slides.3.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Mes prix sont publics depuis. Enregistre ce post pour y repenser.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"caption.hook\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Un bol, trois passages.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"caption.body\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Voilà pourquoi je n'ai plus de remises.\\\\\\"},{\\\\\\"id\\\\\\":\\\\\\"caption.cta\\\\\\",\\\\\\"text\\\\\\":\\\\\\"Tu affiches tes prix ?\\\\\\"}]}}\\"
  },
