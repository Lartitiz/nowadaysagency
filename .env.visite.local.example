# Visite guidée Playwright — secrets LOCAUX.
# Copie ce fichier en .env.visite.local (jamais commité, couvert par .env.*.local)
# et renseigne le mot de passe du compte test "Camille".
VISITE_EMAIL=laetitiatest@nowadaysagency.com
VISITE_PASSWORD=colle-ici-le-mot-de-passe-du-compte-test
# Décommente pour viser un autre environnement (par défaut : site live)
# VISITE_BASE_URL=https://nowadays-assistant.fr

# Optionnel : compte AVEC le rôle admin (table user_roles), pour tester
# l'accès admin légitime (e2e-visite/admin-access.spec.ts). Sans ce couple,
# ce test est simplement sauté.
# VISITE_ADMIN_EMAIL=laetitia@nowadaysagency.com
# VISITE_ADMIN_PASSWORD=colle-ici-le-mot-de-passe-du-compte-admin
