# Compte de test de l'app pour l'examinateur Meta (Contrôle app Instagram).
# Copie ce fichier en .env.meta-review.local (jamais commité, couvert par .env.*.local) :
# le dépôt est PUBLIC, le vrai mot de passe ne doit vivre que dans la copie locale.
# Ces identifiants se collent dans Meta > Contrôle app > « Instructions pour l'examinateur ».
META_REVIEW_APP_URL=https://nowadays-assistant.fr/connexion
META_REVIEW_EMAIL=laetitia+metareview@nowadaysagency.com
META_REVIEW_PASSWORD=colle-ici-le-mot-de-passe-du-compte-examinateur
